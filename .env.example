# ============================================================
#  قالب متغيّرات البيئة — انسخ هذا الملف باسم .env.local
#  واملأ القيم، ثم لا ترفعه إلى GitHub (محمي في .gitignore).
# ============================================================

# رابط قاعدة بيانات Neon (Pooled) — مطلوب.
# من: Neon Dashboard ← مشروعك ← Connection Details ← Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# رابط مباشر بدون تجميع (اختياري — يُستخدم لأوامر npm run db:push و db:seed).
# من نفس الصفحة: اختر "Direct connection".
DATABASE_URL_UNPOOLED=""

# رمز تهيئة قاعدة البيانات عبر /api/setup?token=... (اختياري، 8 أحرف على الأقل).
# بعد انتهاء التهيئة احذفه لتعطيل النقطة.
SETUP_TOKEN=""

# ------------ إعدادات متقدمة (اتركها كما هي عادةً) ------------

# تمكين التحقق الكامل من شهادة SSL الخاصة بـ Neon (قد يفشل على بعض البيئات).
# القيمة الافتراضية false = اتصال مشفّر بدون تحقق من الشهادة.
DB_SSL_STRICT="false"

# شهادة CA (PEM) للتحقق الكامل إن أردت ذلك.
DATABASE_CA_CERT=""

# أقصى عدد اتصالات لكل نسخة من الدالة على Vercel (الافتراضي 5).
PG_POOL_MAX=""
